{
  "expo": {
    "name": "Gym Platform",
    "slug": "gym-platform",
    "scheme": "gym-platform",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymapp.gymplatform"
    },
    "android": {
      "package": "com.gymapp.gymplatform",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-auth-session",
        {
          "redirectUriOptions": {
            "custom": "gym-platform://oauth2redirect"
          }
        }
      ]
    ]
  }
}
