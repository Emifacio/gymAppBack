PROJECT_NAME=Gym Backend
ENVIRONMENT=local
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
DATABASE_URL=postgresql+asyncpg://gym:gym@postgres:5432/gym_db
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_COMMAND_TIMEOUT_SECONDS=30
DATABASE_STARTUP_MAX_ATTEMPTS=10
DATABASE_STARTUP_INITIAL_BACKOFF_SECONDS=1
DATABASE_STARTUP_MAX_BACKOFF_SECONDS=8
DATABASE_STARTUP_BACKOFF_MULTIPLIER=1.5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_USE_LIFO=true
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_TTL_SECONDS=300
REDIS_CONNECT_TIMEOUT_SECONDS=5
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Optional: allow preview domains, for example
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
TIMEZONE=UTC
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_API_BASE_URL=https://www.strava.com/api/v3
GOOGLE_CLIENT_ID=597337220893-sdtfpcs29epj7cr6l2fctrb7jj2eopg9.apps.googleusercontent.com
# Optional: comma-separated additional allowed client IDs (mobile + web)
GOOGLE_CLIENT_IDS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM=
EMAIL_REPLY_TO=
POSTGRES_DB=gym_db
POSTGRES_USER=gym
POSTGRES_PASSWORD=gym

# Railway production service references:
# REDIS_URL=${{Redis.REDIS_URL}}
# CELERY_BROKER_URL=${{Redis.REDIS_URL}}
# CELERY_RESULT_BACKEND=${{Redis.REDIS_URL}}
